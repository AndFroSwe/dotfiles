{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "newline": false,
      "segments": [
        {
          "type": "path",
          "foreground": "p:onPrimaryContainer",
          "background": "p:primaryContainer",
          "leading_diamond": "",
          "trailing_diamond": "",
          "options": {
            "style": "agnoster",
            "home_icon": " ",
            "folder_icon": "",
            "folder_separator_icon": " / ",
            "mapped_locations": {
              "~/.config": "",
              "~/Gitrepos": "󰊢",
              "~/API": "󰏗",
              "~/Scratchpad": "󱓧",
              "~/Libs": ""
            }
          },
          "style": "diamond",
          "template": " {{ .Path }} "
        },
        {
          "type": "cmake",
          "style": "diamond",
          "trailing_diamond": "",
          "foreground": "p:onSecondaryContainer",
          "background": "p:secondaryContainer",
          "template": "   cmake "
        },
        {
          "type": "go",
          "style": "diamond",
          "trailing_diamond": "",
          "foreground": "p:onSecondaryContainer",
          "background": "p:secondaryContainer",
          "template": "  Go "
        },
        {
          "type": "git",
          "style": "diamond",
          "trailing_diamond": "",
          "foreground": "p:onTertiaryContainer",
          "background": "p:tertiaryContainer",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:onPrimary{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:onPrimary{{ end }}",
            "{{ if gt .Ahead 0 }}p:onPrimary{{ end }}",
            "{{ if gt .Behind 0 }}p:onPrimary{{ end }}"
          ],
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:primary{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:primary{{ end }}",
            "{{ if gt .Ahead 0 }}p:primary{{ end }}",
            "{{ if gt .Behind 0 }}p:primary{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }} {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }}",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "text",
          "style": "plain",
          "template": "  "
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": false,
  "version": 3,
  "palette": {
    "primary": "#cfbdfe",
    "onPrimary": "#36265d",
    "primaryContainer": "#4d3d75",
    "onPrimaryContainer": "#e9ddff",
    "inversePrimary": "#65558f",
    "primaryFixed": "#e9ddff",
    "primaryFixedDim": "#cfbdfe",
    "onPrimaryFixed": "#201047",
    "onPrimaryFixedVariant": "#4d3d75",
    "secondary": "#ccc2db",
    "onSecondary": "#332d41",
    "secondaryContainer": "#4a4458",
    "onSecondaryContainer": "#e8def8",
    "secondaryFixed": "#e8def8",
    "secondaryFixedDim": "#ccc2db",
    "onSecondaryFixed": "#1e192b",
    "onSecondaryFixedVariant": "#4a4458",
    "tertiary": "#efb8c8",
    "onTertiary": "#4a2532",
    "tertiaryContainer": "#633b48",
    "onTertiaryContainer": "#ffd9e3",
    "tertiaryFixed": "#ffd9e3",
    "tertiaryFixedDim": "#efb8c8",
    "onTertiaryFixed": "#31101d",
    "onTertiaryFixedVariant": "#633b48",
    "error": "#ffb4ab",
    "onError": "#690005",
    "errorContainer": "#93000a",
    "onErrorContainer": "#ffdad6",
    "surface": "#141218",
    "onSurface": "#e6e0e9",
    "surfaceDim": "#141218",
    "surfaceBright": "#3b383e",
    "surfaceVariant": "#49454e",
    "onSurfaceVariant": "#cac4cf",
    "surfaceContainerLowest": "#0f0d13",
    "surfaceContainerLow": "#1d1b20",
    "surfaceContainer": "#211f24",
    "surfaceContainerHigh": "#2b292f",
    "surfaceContainerHighest": "#36343a",
    "surfaceTint": "#cfbdfe",
    "background": "#141218",
    "onBackground": "#e6e0e9",
    "outline": "#948f99",
    "outlineVariant": "#49454e",
    "inverseSurface": "#e6e0e9",
    "inverseOnSurface": "#322f35",
    "shadow": "#000000",
    "scrim": "#000000",
    "sourceColor": "#330e78"
  }
}
